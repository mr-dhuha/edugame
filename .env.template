# ==================================================================
# CHEMQUEST ENVIRONMENT VARIABLES
# ==================================================================
# Instruksi:
# 1. Ganti nama file ini dari `.env.template` menjadi `.env.local`
# 2. Dapatkan URL dan Anon Key dari dashboard Supabase Anda:
#    Project Settings -> API
# ==================================================================

# URL Supabase (contoh: https://xyz.supabase.co)
VITE_SUPABASE_URL=YOUR_SUPABASE_URL_HERE

# Supabase Anon/Public Key (contoh: eyJhbGciOiJIUzI1NiIsInR5c...)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Konfigurasi Opsional
VITE_ENABLE_ANALYTICS=true
VITE_DEBUG_MODE=false
